# =====================================================================
#  Diagon Store — backend environment variables
#  Copy this file to backend/.env and replace the placeholders.
#  NEVER commit the real .env file.
#
#  [REQUIRED]  the server will not start without these
#  [OPTIONAL]  has a sensible default
#  [FUTURE]    reserved for a planned feature (see docs/ROADMAP.md) — not read yet
# =====================================================================

# ---------------------------------------------------------------------
# Server  [OPTIONAL]
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# 127.0.0.1 for local dev, 0.0.0.0 when deploying to a server/container
HOST=127.0.0.1
# Shop address(es) allowed to call the API — comma-separated, exact (https://...) in production
CLIENT_URL=http://localhost:5173
# Public URL of this API (used for links in emails)
API_PUBLIC_URL=http://127.0.0.1:5000
# Public URL of the shop (sitemap.xml, robots.txt, email links and the order links in WhatsApp
# messages). In production the exact https:// address, or WhatsApp previews will not load.
SITE_URL=http://localhost:5173

# ---------------------------------------------------------------------
# Database (MySQL / MariaDB)  [REQUIRED]
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# XAMPP default (root, no password) is for LOCAL DEVELOPMENT ONLY.
# In production create a dedicated database user with a strong password and
# only the rights it needs (SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, REFERENCES).
# URL-encode special characters in the password (@ -> %40, # -> %23)
# ---------------------------------------------------------------------
DATABASE_URL=mysql://root:@localhost:3306/diagon_store
DB_CONNECTION_LIMIT=5

# ---------------------------------------------------------------------
# Admin sessions  [REQUIRED]
# Signs the admin session cookie. 32+ random characters; the server refuses
# placeholders in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs every admin out.
# ---------------------------------------------------------------------
JWT_SECRET=
# How long an admin stays signed in
JWT_EXPIRES_IN=8h
# HTTPS-only session cookie. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true

# Admin accounts are created at the terminal — no passwords in files:
#   npm run create-admin            (asks for email, name and password, typing hidden)
#   npm run create-admin -- --reset (new password for an existing admin, also unlocks it)

# ---------------------------------------------------------------------
# Store  [OPTIONAL]
# Business details (phone, WhatsApp, email, address, social links, hours)
# are edited in Admin → Settings and stored in the database.
# ---------------------------------------------------------------------
STORE_NAME=Diagon Store
STORE_CURRENCY=LKR
# Prefix for order numbers, e.g. DS-2026-000123
ORDER_NUMBER_PREFIX=DS
# Fallback WhatsApp number until it is set in Admin → Settings
# International format, digits only (Sri Lanka: 94XXXXXXXXX)
SHOP_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------
# Email — order/inquiry notifications via SMTP  [OPTIONAL]
# EMAIL_ENABLED=false logs emails to the console instead of sending.
# Works with any SMTP provider:
#   Gmail (app password)  smtp.gmail.com   587
#   Resend                smtp.resend.com  587  user=resend  pass=<API key>
#   Brevo                 smtp-relay.brevo.com 587
# ---------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_FROM="Diagon Store <orders@diagonstore.lk>"
# Where new-order emails go (falls back to the email in Admin → Settings)
EMAIL_ADMIN_NOTIFY=owner@diagonstore.lk
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ---------------------------------------------------------------------
# Image uploads  [OPTIONAL]
# Stored on disk in backend/<UPLOAD_DIR> and served at /uploads
# ---------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ---------------------------------------------------------------------
# Security  [OPTIONAL]
# ---------------------------------------------------------------------
# Max failed admin sign-ins per IP per 15 minutes
LOGIN_RATE_LIMIT=10
# Wrong passwords in a row before an admin account is locked, and for how long
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
# Requests per IP per 5 minutes across the whole API
API_RATE_LIMIT=600
# Max orders/inquiries per IP per hour (spam protection)
ORDER_RATE_LIMIT=10

# =====================================================================
# [FUTURE] Not used yet — kept so keys are ready when the features land
# =====================================================================

# Cloudinary image hosting (alternative to local uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# WhatsApp Cloud API automation (automatic order/status messages)
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret

# PayHere online payments — https://support.payhere.lk/api-&-mobile-sdk/checkout-api
PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_NOTIFY_URL=https://your-public-api-url/api/payments/payhere/notify
