# =====================================================================
#  Diagon Store — backend environment variables
#  Copy this file to backend/.env and replace every placeholder.
#  NEVER commit the real .env file.
#
#  [REQUIRED]  needed to start the server today
#  [PHASE n]   needed once that roadmap phase is built (see docs/ROADMAP.md)
# =====================================================================

# ---------------------------------------------------------------------
# Server  [REQUIRED]
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# 127.0.0.1 for local dev, 0.0.0.0 when deploying to a server/container
HOST=127.0.0.1
# Frontend origin(s) allowed by CORS — comma-separated
CLIENT_URL=http://localhost:5173
# Public URL of this API (used in emails, PayHere notify URL, image links)
API_PUBLIC_URL=http://127.0.0.1:5000

# ---------------------------------------------------------------------
# Database (MySQL / MariaDB)  [REQUIRED]
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# URL-encode special characters in the password (@ -> %40, # -> %23)
# ---------------------------------------------------------------------
DATABASE_URL=mysql://root:your_db_password@localhost:3306/diagon_store
DB_CONNECTION_LIMIT=5

# ---------------------------------------------------------------------
# Admin authentication  [REQUIRED]
# Generate a secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# First admin account — used only by `npm run create-admin`
ADMIN_NAME=Diagon Store Admin
ADMIN_EMAIL=admin@diagonstore.lk
ADMIN_PASSWORD=change_me_to_a_strong_password

# ---------------------------------------------------------------------
# Store settings / COD  [PHASE 4]
# ---------------------------------------------------------------------
STORE_NAME=Diagon Store
STORE_CURRENCY=LKR
# Default COD delivery fee in LKR (can be overridden per district in admin settings)
DEFAULT_DELIVERY_FEE=400
# Orders at or above this amount get free delivery (0 = disabled)
FREE_DELIVERY_THRESHOLD=0
# Prefix for human-readable order numbers, e.g. DS-2026-000123
ORDER_NUMBER_PREFIX=DS

# ---------------------------------------------------------------------
# WhatsApp  [PHASE 5]
# Meta WhatsApp Cloud API — https://developers.facebook.com/docs/whatsapp/cloud-api
# ---------------------------------------------------------------------
# Shop's WhatsApp number in international format, no + or spaces (Sri Lanka: 94XXXXXXXXX)
SHOP_WHATSAPP_NUMBER=94770000000
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
# Permanent System-User access token (not the 24h temporary token)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
# Any string you choose; must match the value entered in the Meta webhook settings
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
# App secret — used to verify webhook signatures
WHATSAPP_APP_SECRET=your_meta_app_secret
# Approved message template names
WHATSAPP_TEMPLATE_NEW_ORDER=new_order_alert
WHATSAPP_TEMPLATE_ORDER_STATUS=order_status_update

# ---------------------------------------------------------------------
# Email  [PHASE 6]
# Choose ONE provider: resend | smtp
# ---------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_FROM="Diagon Store <orders@diagonstore.lk>"
# Where new-order notifications for the shop are sent
EMAIL_ADMIN_NOTIFY=owner@diagonstore.lk

# Resend — https://resend.com
RESEND_API_KEY=re_your_resend_api_key

# SMTP (Gmail app password, Brevo, Mailgun, Zoho, ...)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ---------------------------------------------------------------------
# Product image storage  [PHASE 2]
# Choose ONE: local | cloudinary
# ---------------------------------------------------------------------
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Cloudinary — https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=diagon-store

# ---------------------------------------------------------------------
# PayHere online payments  [PHASE 7]
# https://support.payhere.lk/api-&-mobile-sdk/checkout-api
# ---------------------------------------------------------------------
PAYHERE_ENABLED=false
# true = sandbox.payhere.lk, false = www.payhere.lk
PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_RETURN_URL=http://localhost:5173/order/success
PAYHERE_CANCEL_URL=http://localhost:5173/checkout
# Must be publicly reachable (use ngrok/cloudflared in local dev)
PAYHERE_NOTIFY_URL=https://your-public-api-url/api/payments/payhere/notify

# ---------------------------------------------------------------------
# Security  [PHASE 1]
# ---------------------------------------------------------------------
# Max admin login attempts per IP per 15 minutes
LOGIN_RATE_LIMIT=10
# Max order placements per IP per hour (spam protection for COD)
ORDER_RATE_LIMIT=10
