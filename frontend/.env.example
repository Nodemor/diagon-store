# =====================================================================
#  Diagon Store — frontend environment variables
#  Copy this file to frontend/.env and adjust.
#  Only variables starting with VITE_ are exposed to the browser —
#  NEVER put secrets (API keys, tokens, merchant secrets) here.
# =====================================================================

# Backend API base URL  [REQUIRED]
VITE_API_URL=http://127.0.0.1:5000/api

# Store display info
VITE_STORE_NAME=Diagon Store
VITE_CURRENCY=LKR

# Shop WhatsApp number for the "Order via WhatsApp" / chat button  [PHASE 5]
# International format, no + or spaces (Sri Lanka: 94XXXXXXXXX)
VITE_STORE_WHATSAPP_NUMBER=94770000000

# PayHere  [PHASE 7] — sandbox flag only; the merchant secret stays on the backend
VITE_PAYHERE_SANDBOX=true
