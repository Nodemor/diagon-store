# =====================================================================
#  Diagon Store — frontend environment variables
#  Copy this file to frontend/.env and adjust.
#  Only variables starting with VITE_ are exposed to the browser —
#  NEVER put secrets (API keys, tokens, passwords) here.
#
#  Store name, WhatsApp number, email, social links etc. come from the
#  API (Admin → Settings), not from this file.
# =====================================================================

# API address. Keep "/api": the shop and the API share one address
# (Vite forwards /api in development; your web server does it in production).
# This lets the admin session use a secure same-site cookie.
VITE_API_URL=/api

# Development only: where Vite forwards /api, /uploads, /sitemap.xml, /robots.txt
VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# Secret back-office address (hash only — the address itself is never stored here).
# Generate with:  npm run admin-path
# Empty = the back office is at /admin (fine for local development, NOT for production).
VITE_ADMIN_PATH_HASH=
